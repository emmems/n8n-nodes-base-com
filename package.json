{
  "name": "n8n-nodes-base-com",
  "version": "0.2.0",
  "description": "n8n community node for the Base (formerly BaseLinker) API: orders, product catalog, external storages and courier shipments",
  "keywords": [
    "n8n-community-node-package",
    "n8n",
    "base",
    "base.com",
    "baselinker",
    "ecommerce",
    "orders",
    "inventory"
  ],
  "license": "MIT",
  "homepage": "https://github.com/emmems/n8n-nodes-base-com#readme",
  "author": {
    "name": "Piotr Michalik"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/emmems/n8n-nodes-base-com.git"
  },
  "main": "index.js",
  "scripts": {
    "build": "tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "prepublishOnly": "npm run build && npm run lint -c .eslintrc.prepublish.js nodes credentials package.json",
    "dev:n8n": "sh ./scripts/mac.sh"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/BaseComApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Base/Base.node.js"
    ]
  },
  "devDependencies": {
    "@types/express": "^4.17.6",
    "@types/request-promise-native": "~1.0.15",
    "@typescript-eslint/parser": "~5.45",
    "eslint-plugin-n8n-nodes-base": "^1.11.0",
    "gulp": "^4.0.2",
    "n8n-core": "*",
    "n8n-workflow": "*",
    "prettier": "^2.7.1",
    "typescript": "~4.8.4"
  },
  "dependencies": {
    "zod": "^3.22.4"
  },
  "bugs": {
    "url": "https://github.com/emmems/n8n-nodes-base-com/issues"
  },
  "engines": {
    "node": ">=18.10"
  }
}
